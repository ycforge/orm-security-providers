{
  "name": "@ycforge/orm-security-providers",
  "version": "0.1.0",
  "description": "Encryption & blind-index providers for @ycforge/ydb-orm (Yandex Cloud KMS, HMAC-SHA256)",
  "keywords": [
    "yandex-cloud",
    "kms",
    "encryption",
    "blind-index",
    "hmac",
    "ydb-orm",
    "orm",
    "provider"
  ],
  "author": "ycforge (https://github.com/ycforge)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./yandex-kms": {
      "types": "./dist/yandex-kms/index.d.ts",
      "default": "./dist/yandex-kms/index.js"
    },
    "./hmac-bi": {
      "types": "./dist/hmac-bi/index.d.ts",
      "default": "./dist/hmac-bi/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ycforge/orm-security-providers.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "yarn build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPatterns='integration\\.spec\\.ts$'",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "peerDependencies": {
    "@ycforge/ydb-orm": ">=0.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@ycforge/ydb-orm": "0.1.1-beta.1",
    "dotenv": "^17.4.2",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "./src/__tests__/setup.ts"
    ]
  }
}
