# Yandex Cloud KMS — integration-тесты провайдера шифрования для ydb-orm
#
# Скопируйте в .env и заполните реальными значениями:
#   cp .env.example .env
#
# Integration-тесты (yarn test:integration) пропускаются, если переменные не заданы.

# ID симметричного ключа Yandex Cloud KMS
# Получить: yc kms symmetric-key get --id <key_id>
KMS_KEY_ID=aby...

# Способ авторизации: meta | auth_key | iam_token
KMS_AUTH_TYPE=iam_token

# ── auth_key ──────────────────────────────────────────────
# Путь к authorized_key.json сервисного аккаунта
# Создать: yc iam service-account create --name kms-test
#          yc iam key create --service-account-id <sa_id> --output authorized_key.json
KMS_AUTHORIZED_KEY_PATH=./authorized_key.json

# ── iam_token ─────────────────────────────────────────────
# IAM-токен напрямую (получить: yc iam create-token)
KMS_IAM_TOKEN=

# ── blind index ───────────────────────────────────────────
# HMAC-ключ для blind index (base64, ≥32 байта)
# Сгенерировать: openssl rand -base64 32
KMS_BLIND_INDEX_KEY=
